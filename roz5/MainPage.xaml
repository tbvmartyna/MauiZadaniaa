<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="roz5.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="Ocena"
                FontSize="26"
                TextColor="#000283"
                FontAttributes="Bold"/>
            <Slider
                x:Name="slider"
                Minimum="1"
                Maximum="6"
                ValueChanged="OnSliderValueChanged" />
            <Label
                x:Name="suwakValue"
                Text="Ocena: 3" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
