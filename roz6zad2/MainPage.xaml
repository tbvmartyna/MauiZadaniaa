<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="roz6zad2.MainPage"
             Title="Suwak">

    <VerticalStackLayout
        Padding="30,0"
        Spacing="25">
        <Slider
            x:Name="slider"
            Minimum="0"
            Maximum="255"
            ValueChanged="OnSliderValueChanged" />

        <Label
            x:Name="sliderValueLabel"
            Text="Wartość suwaka: 0"
            FontSize="18"/>
        <Label
            x:Name="sliderSLowoLabel"
            Text=" "
            FontSize="18"/>
    </VerticalStackLayout>

</ContentPage>
