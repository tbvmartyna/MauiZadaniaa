<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="roz7zad3.MainPage"
             Title="Suwaki">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
          <Slider
              x:Name="sliderR"
              Minimum="0"
              Maximum="255"
              ValueChanged="OnSliderValueChanged" />
            <Slider
                x:Name="sliderG"
                Minimum="0"
                Maximum="255"
                ValueChanged="OnSliderValueChanged" />
            <Slider
                x:Name="sliderB"
                Minimum="0"
                Maximum="255"
                ValueChanged="OnSliderValueChanged" />
            <Label
                x:Name="sliderValueLabel"
                Text="Zapis szesnastkowy: 000000"
                FontSize="18"
                PropertyChanged="OnSLiderRGBChanged"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
